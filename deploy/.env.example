# Copy this file to deploy/.env and fill in real values. deploy/.env is gitignored
# (via the repo's top-level ".env" rule) — never commit it.

# The DNS name pointing at this box's public IP (e.g. a free DuckDNS subdomain:
# yourname.duckdns.org). Caddy uses this to request a Let's Encrypt certificate,
# so it must already resolve to this machine before you start the stack.
SIMULOOM_DOMAIN=yourname.duckdns.org

# JSON object of {api-key: {"subject": "...", "role": "admin"|"operator"|"viewer"}}.
# Each key must be at least 16 characters. Generate a strong key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SIMULOOM_API_KEYS={"REPLACE_WITH_A_GENERATED_KEY":{"subject":"you","role":"admin"}}

# Signs the tamper-evident domain audit log. Generate the same way:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SIMULOOM_AUDIT_SIGNING_KEY=REPLACE_WITH_A_DIFFERENT_GENERATED_KEY
